{
  "manifest_version": 3,
  "name": "Efekta AI Bridge",
  "version": "3.0.0",
  "description": "High-speed cross-browser automation bridge & Voice Engine connecting learn.better.efekta.com to efekta-cli & MCP for AI agents.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.efekta.com/*",
    "*://*.better.efekta.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* https://*"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.efekta.com/*",
        "*://*.better.efekta.com/*"
      ],
      "js": ["injected.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.efekta.com/*",
        "*://*.better.efekta.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "*://*.efekta.com/*",
        "*://*.better.efekta.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Efekta AI Bridge",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "efekta-bridge@efekta-cli.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
